{
  "ai-traffic-light-win": {
    "enabled": true,
    "preInvocation": [
      {
        "type": "command",
        "command": "__HOOK_CMD__ set working antigravity",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "cmd.exe /c exit 0",
        "timeout": 1
      }
    ],
    "preToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "__HOOK_CMD__ set working antigravity",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "cmd.exe /c exit 0",
            "timeout": 1
          }
        ]
      }
    ],
    "postToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "__HOOK_CMD__ set working antigravity",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "cmd.exe /c exit 0",
            "timeout": 1
          }
        ]
      }
    ],
    "postInvocation": [
      {
        "type": "command",
        "command": "__HOOK_CMD__ set idle antigravity",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "cmd.exe /c exit 0",
        "timeout": 1
      }
    ],
    "stop": [
      {
        "type": "command",
        "command": "__HOOK_CMD__ set idle antigravity",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "cmd.exe /c exit 0",
        "timeout": 1
      }
    ]
  }
}
